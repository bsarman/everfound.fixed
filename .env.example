# Database (PostgreSQL)
# Recommended free options: Neon, Supabase, or Vercel Postgres
DATABASE_URL="postgresql://user:password@host:5432/everfound?sslmode=require"

# Session encryption key — MUST be at least 32 characters
# Generate one with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Optional
NODE_ENV="development"
